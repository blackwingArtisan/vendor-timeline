# Copy to .env.local only if this app needs values different from ../../.env.shared.
# Load order (first wins): real environment > .env.local > ../../.env.shared (> ../.env.shared for the kit).

# mock = no credentials, in-memory PayPal. sandbox = real https://api-m.sandbox.paypal.com.
# Any other value refuses to start: there is no live mode.
PAYPAL_MODE=mock

# Sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id for https://<your-app>/api/paypal/webhooks. Empty = incoming webhooks are rejected (503).
PAYPAL_WEBHOOK_ID=

# Sandbox test accounts used in demos (developer.paypal.com > Testing Tools > Sandbox Accounts).
PAYPAL_SANDBOX_SELLER_EMAIL=
PAYPAL_SANDBOX_BUYER_EMAIL=

# Claude. Empty = AI mock mode (fixtures + scripted agent), everything still runs.
ANTHROPIC_API_KEY=
# Hard daily cap on Claude spend in USD (default 2). Calls whose worst case would exceed it are refused.
AI_DAILY_CAP_USD=2

# Optional
# AI_MODE=mock                    # force AI mock mode even with a key
# AI_RATE_LIMIT_PER_MINUTE=8      # per IP, AI routes
# AI_RATE_LIMIT_PER_DAY=150       # per IP, AI routes
# API_RATE_LIMIT_PER_MINUTE=120   # per IP, other mutating routes
# MOCK_PAYPAL_LATENCY_MS=120-420  # simulated mock latency
# KIT_DATA_DIR=.data              # local JSON state (mock PayPal, ledger, audit log, AI spend)
